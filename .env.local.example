# Firebase web app config (Project settings → General → Your apps → SDK setup and configuration)
# Copy this file to .env.local and fill in your values. Node-RED writes readings into the same
# Firestore project under plants/{plantId}/rooms/{roomId}, which this app reads live.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-only (route handlers via firebase-admin). Service account: Project settings → Service accounts.
# Keep the private key in quotes with literal \n line breaks. Never prefix these with NEXT_PUBLIC_.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Local development against the Firebase emulator (no credentials needed when set):
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
